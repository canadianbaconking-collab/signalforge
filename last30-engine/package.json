{
  "name": "signalforge",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only server/index.ts",
    "build": "tsc",
    "start": "node dist/server/index.js",
    "smoke": "node tests/smoke.js",
    "test:evidence": "node --test tests/evidence.js",
    "test:collectors": "node --test tests/collectors.js",
    "test:reviews": "node --test tests/reviews.js",
    "test:canonical": "node --test tests/canonical.js",
    "test:comparison": "node --test tests/comparison.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.5.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.19",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.7.2",
    "typescript": "^5.3.3"
  }
}
